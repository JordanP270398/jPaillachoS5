<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jPaillachoS5.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout
        Padding="15"
        Spacing="15">
        <Label 
            Text="Semana 5: SQLITE"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry x:Name="txtNombre"
               Placeholder="Ingresar el nombre"/>

        <Grid Padding="5" RowSpacing="1" ColumnSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btbAgregar"
                    Text="Agregar Persona"
                    Clicked="btbAgregar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"/>
            
            <Label x:Name="lblMessage"
                   TextColor="Red"
                   Grid.Row="1"
                   Grid.Column="0"/>

            <Button x:Name="btnMostrar"
                    Text="Mostrar Personas"
                    Clicked="btnMostrar_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"/>

            <CollectionView x:Name="ListaPersonas"
                            Grid.Row="3"
                            Grid.Column="0">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                          ColumnDefinitions="50,*,Auto"
                          ColumnSpacing="15"
                          Padding="5">

                            <Label
                Text="{Binding Id}"
                Grid.Column="0"
                VerticalOptions="Center" />

                            <Label
                Text="{Binding Name}"
                Grid.Column="1"
                VerticalOptions="Center" />

                            <Button
                Text="Eliminar"
                Grid.Column="2"
                BackgroundColor="DarkRed"
                TextColor="White"
                CommandParameter="{Binding Id}" 
                Clicked="btnEliminar_Clicked"/>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                            
            </CollectionView>

        </Grid>
        
    </VerticalStackLayout>
</ContentPage>